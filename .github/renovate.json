{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "pip-compile": {
    "managerFilePatterns": [
      "/^app/requirements\\.txt$/",
      "/^app/requirements-dev\\.txt$/"
