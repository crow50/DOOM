# ---------------------------------------------------------------------------
# D.O.O.M. configuration
#
# Copy to .env and run `make init` to fill in the secrets:
#     cp .env.example .env && make init
#
# Every CHANGE_ME below is rejected at startup by app/doom/config.py.
# The app will refuse to boot rather than run with a known-guessable secret
# (T-05: a guessable SECRET_KEY makes every session cookie forgeable).
# ---------------------------------------------------------------------------

# --- Secrets: generated by `make init`, never edited by hand ---------------
SECRET_KEY=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME
APP_DB_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME

# --- Public identity -------------------------------------------------------
# The hostname Caddy serves and the app trusts.  "localhost" makes Caddy issue
# a certificate from its own internal CA.
DOOM_DOMAIN=localhost

# Absolute base URL burned into every QR code and NFC tag.
#
# This MUST be the address a phone will actually use, and it must be correct
# BEFORE you print any labels (T-14).  Labels printed against "localhost" are
# permanently useless, and generated URLs are never derived from the inbound
# Host header.
PUBLIC_BASE_URL=https://localhost:8443

# Optional: email for Let's Encrypt when DOOM_DOMAIN is a real public domain.
ACME_EMAIL=

# --- Host ports ------------------------------------------------------------
# Unprivileged by default so this works under rootless Docker, which
# refuses to bind ports below 1024. On a rootful Docker daemon you can
# set 80/443 and drop the port from PUBLIC_BASE_URL.
HTTP_PORT=8080
HTTPS_PORT=8443

# --- Database --------------------------------------------------------------
# Two roles by design (T-35):
#   doom_admin - owns the schema, used ONLY by `make migrate`
#   doom_app   - SELECT/INSERT/UPDATE/DELETE only, used by the running app
# The application never holds admin credentials.
POSTGRES_DB=doom
POSTGRES_ADMIN_USER=doom_admin
APP_DB_USER=doom_app

# --- Runtime ---------------------------------------------------------------
# Bounded deliberately: each Argon2id hash reserves 64 MiB, so worker count
# times concurrent logins must fit the container memory limit (T-30).
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
LOG_LEVEL=INFO

# --- Barcode lookup (optional, off by default) ------------------------------
# The ONLY outbound network call this application makes, and a deliberate
# exception to the rule that user-supplied values are never fetched (D-13).
#
# Leave blank and nothing is ever sent anywhere: scanning still works, it just
# stores the number instead of looking up a product name.
#
# Enabling it sends product barcodes to a third party. Valid values name a
# provider defined in app/doom/validation.py - never a URL:
#   openfoodfacts   Open data, no account. Food and household goods.
#   upcitemdb       General merchandise. Rate limited.
BARCODE_LOOKUP_PROVIDER=
